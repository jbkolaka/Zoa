<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- targetSdk is 28+, where Android blocks plaintext HTTP by default — and
         that block applies to 127.0.0.1 too, so an `adb reverse` tunnel to a
         local `go run ./cmd/api` is refused by the platform before dio ever
         opens a socket. Dev backends speak HTTP, so permit cleartext here.

         Declared in the *debug* manifest, not the main one: this only ever
         applies to debug builds, and release stays HTTPS-only rather than
         shipping a downgrade-attack hole to demo the app faster. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
