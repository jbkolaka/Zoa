# Zoa backend — copy to .env and adjust. Never commit .env.

# HTTP port the API listens on.
PORT=8080

# SQLite database file. In Docker this points at the mounted volume.
DB_PATH=app.db

# dev | demo | prod
# Outside dev, JWT_SECRET is required and the server refuses to start without it.
APP_ENV=dev

# Signing secret for JWTs (Phase 1). Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Comma-separated allowed origins, or * for any.
# Android builds ignore CORS; this matters for Flutter web and browser testing.
CORS_ORIGINS=*

# --- Phase 2.5: AI material classification ---

# Which classifier to use: claude | mock | off
# Unset resolves automatically: "claude" when ANTHROPIC_API_KEY is present,
# otherwise "mock" — so a fresh clone still demonstrates the AI step rather than
# silently omitting it. "off" disables classification entirely (the endpoint then
# always answers degraded, and manual selection carries the flow).
ZOA_CLASSIFY_PROVIDER=

# Vision model. Defaults to claude-opus-5.
ZOA_CLASSIFY_MODEL=

# Per-call budget (TRD §3 asks for <3s). Exceeding it degrades to manual
# selection rather than failing the request.
ZOA_CLASSIFY_TIMEOUT=3s

# Anthropic API key. Never commit a real key — .env is gitignored.
# The SDK also reads this from the ambient environment.
ANTHROPIC_API_KEY=
